generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Clerk userId
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Majorations configurables (multiplicateurs, ex: 0.1 = +10%)
  nightMult   Float @default(0.1)
  sundayMult  Float @default(0.1)
  holidayMult Float @default(1.0)

  // Heures supplémentaires : multiplicateur (0.25 = +25%)
  overtimeMult Float @default(0.25)
  nightStart  Int   @default(21) // début fenêtre nuit (heure locale)
  nightEnd    Int   @default(6) // fin fenêtre nuit

  // Rappels
  reminderEnabled   Boolean   @default(true)
  reminderThreshold Int       @default(7) // jours sans vacation avant rappel
  lastReminderAt    DateTime?

  // Conversion brut → net (part salariée conservée, ex 0.78)
  netRatio Float @default(0.78)

  hourlyRates HourlyRate[]
  workShifts  WorkShift[]
  payslips    Payslip[]
  pushSubscriptions PushSubscription[]
}

model HourlyRate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rate      Float    // taux horaire en euros
  validFrom DateTime @default(now()) // début de validité, historique
  updatedAt DateTime @updatedAt

  @@index([userId, validFrom])
}

model WorkShift {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Jour civil à minuit (pour index/calendrier) + datetime complet (date+heure).
  // startDate/endDate = jours civils (T00:00:00), endDate = +1j si nuit.
  // startTime/endTime = datetimes réels du pointage.
  startDate DateTime
  startTime DateTime
  endDate   DateTime
  endTime   DateTime

  breakMinutes Int @default(0)

  // Calculés à la création : totalHours = endTime-startTime (pause incluse, rémunérée).
  // rateSnapshot = taux figé au moment du pointage (historique).
  // estimatedPay = totalHours × rateSnapshot + premiumPay (majorations nuit/dim/férié).
  totalHours   Float
  estimatedPay Float

  rateSnapshot Float @default(0)
  nightHours   Float @default(0)
  sundayHours  Float @default(0)
  holidayHours Float @default(0)
  premiumPay   Float @default(0)

  // Heures supplémentaires retenues sur cette vacation (dernières heures, avant pause),
  // payées à rate × (1 + overtimeMult). overtimePay = overtimeHours × rate × overtimeMult.
  overtimeHours Float @default(0)
  overtimePay   Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
}

model Payslip {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  year  Int
  month Int? // optionnel

  fileName String
  fileUrl  String

  uploadedAt DateTime @default(now())

  @@index([userId, year])
}

model PushSubscription {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @unique
  p256dh   String
  auth     String

  createdAt DateTime @default(now())

  @@index([userId])
}